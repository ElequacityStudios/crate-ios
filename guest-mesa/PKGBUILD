# Maintainer: Elequacity Studios
# Apple Silicon Venus workaround: round every guest-side Venus allocation to 16 KiB.

pkgname=vulkan-virtio
pkgver=26.2.7
pkgrel=2
epoch=1
pkgdesc="Mesa Venus Vulkan ICD for virtio-gpu, patched for 16 KiB Apple Silicon host pages"
arch=('aarch64')
url="https://www.mesa3d.org/"
license=('MIT')
depends=(
  expat
  glibc
  libdisplay-info
  libdrm
  libgcc
  libstdc++
  libx11
  libxcb
  libxshmfence
  systemd-libs
  vulkan-icd-loader
  wayland
  xcb-util-keysyms
  zlib
  zstd
)
makedepends=(
  glslang
  libdrm
  libelf
  libxml2
  meson
  ninja
  pkgconf
  python-mako
  python-packaging
  python-ply
  python-pycparser
  spirv-tools
  wayland-protocols
)
options=(!lto)
source=(
  "https://archive.mesa3d.org/mesa-${pkgver}.tar.xz"
  "mesa-venus-16k.patch"
)
sha256sums=(
  '04294f75d22e9f61cd1e050206bc48b3d39366e788f1803a3368e3d5a872ce18'
  'SKIP'
)

prepare() {
  cd "mesa-${pkgver}"
  patch -Np1 -i "${srcdir}/mesa-venus-16k.patch"
}

build() {
  meson setup build "mesa-${pkgver}" \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release \
    -Dplatforms=wayland,x11 \
    -Dgallium-drivers= \
    -Dvulkan-drivers=virtio \
    -Dvulkan-layers= \
    -Dopengl=false \
    -Dgles1=disabled \
    -Dgles2=disabled \
    -Dglx=disabled \
    -Degl=disabled \
    -Dgbm=disabled \
    -Dllvm=disabled \
    -Dbuild-tests=false \
    -Dvalgrind=disabled

  meson compile -C build
}

package() {
  DESTDIR="${pkgdir}" meson install -C build --no-rebuild

  install -Dm644 "mesa-${pkgver}/docs/license.rst" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
