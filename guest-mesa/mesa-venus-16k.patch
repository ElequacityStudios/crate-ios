From 761ef1ec5ff2aae1cc3dc8bbc22b3d06ef04b549 Mon Sep 17 00:00:00 2001
Subject: [PATCH] virtio/vulkan: force 16 KiB alignment for Apple Silicon

The host VM page granule is 16 KiB. Round every Venus ring, shared-memory,
and device-memory allocation up to that granule so the guest kernel never
places a Venus host-visible blob at an incompatible boundary.

This is based on slp/mesa commit 761ef1ec5ff2aae1cc3dc8bbc22b3d06ef04b549.
The device-memory allocation-info copy avoids modifying a const caller-owned
VkMemoryAllocateInfo.

---
diff --git a/src/virtio/vulkan/vn_device_memory.c b/src/virtio/vulkan/vn_device_memory.c
--- a/src/virtio/vulkan/vn_device_memory.c
+++ b/src/virtio/vulkan/vn_device_memory.c
@@ -31,11 +31,14 @@ vn_device_memory_alloc_simple(struct vn_device *dev,
 {
    VkDevice dev_handle = vn_device_to_handle(dev);
    VkDeviceMemory mem_handle = vn_device_memory_to_handle(mem);
+   VkMemoryAllocateInfo aligned_alloc_info = *alloc_info;
+   aligned_alloc_info.allocationSize =
+      align64(alloc_info->allocationSize, 16384);
    if (VN_PERF(NO_ASYNC_MEM_ALLOC)) {
       return vn_call_vkAllocateMemory(dev->primary_ring, dev_handle,
-                                      alloc_info, NULL, &mem_handle);
+                                      &aligned_alloc_info, NULL, &mem_handle);
    }

    struct vn_ring_submit_command ring_submit;
-   vn_submit_vkAllocateMemory(dev->primary_ring, 0, dev_handle, alloc_info,
+   vn_submit_vkAllocateMemory(dev->primary_ring, 0, dev_handle, &aligned_alloc_info,
                               NULL, &mem_handle, &ring_submit);
diff --git a/src/virtio/vulkan/vn_renderer_virtgpu.c b/src/virtio/vulkan/vn_renderer_virtgpu.c
--- a/src/virtio/vulkan/vn_renderer_virtgpu.c
+++ b/src/virtio/vulkan/vn_renderer_virtgpu.c
@@ -654,5 +654,7 @@ virtgpu_bo_create_from_device_memory(
    const uint32_t blob_flags =
       virtgpu_bo_blob_flags(gpu, flags, external_handles);

+   size = align64(size, 16384);
+
    uint32_t res_id;
    uint32_t gem_handle = virtgpu_ioctl_resource_create_blob(
@@ -742,4 +744,6 @@ virtgpu_shmem_create(struct vn_renderer *renderer, size_t size)
 {
    struct virtgpu *gpu = (struct virtgpu *)renderer;

+   size = align64(size, 16384);
+
    struct vn_renderer_shmem *cached_shmem =
       vn_renderer_shmem_cache_get(&gpu->shmem_cache, size);
diff --git a/src/virtio/vulkan/vn_ring.c b/src/virtio/vulkan/vn_ring.c
--- a/src/virtio/vulkan/vn_ring.c
+++ b/src/virtio/vulkan/vn_ring.c
@@ -264,3 +264,3 @@ vn_ring_get_layout(size_t buf_size,
    layout->extra_offset = layout->buffer_offset + layout->buffer_size;
    layout->extra_size = extra_size;
-   layout->shmem_size = layout->extra_offset + layout->extra_size;
+   layout->shmem_size = align64(layout->extra_offset + layout->extra_size, 16384);
--
2.47.0
